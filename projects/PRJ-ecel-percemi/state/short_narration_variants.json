          "shot_range": [
            "SH-R25",
            "SH-R26"
          ],
          "window": "1:20-1:30",
          "window_s": 10,
          "text": "Şimdi anladın mı? Tek bir tutam saçta üç bin yıllık bir felsefe yaşıyordu. Ecel Perçemi.",
          "characters": 88,
          "words": 15,
          "draft_audio": {
