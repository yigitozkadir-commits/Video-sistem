{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-os/schemas/decision.schema.json",
  "title": "Director Decision",
  "description": "A decision without a reason and a rejected alternative is invalid (M17 §3).",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^DEC-\\d{4}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "scene",
            "shot",
            "beat",
            "act",
            "project"
          ]
        },
        "target_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "target_id"
      ]
    },
    "question": {
      "type": "string",
      "enum": [
        "scene_length",
        "camera_choice",
        "video_or_still",
        "music_in",
        "music_out",
        "silence_placement",
        "cut_point",
        "shot_order",
        "motif",
        "format_grammar"
      ]
    },
    "choice": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "beat_ref": {
      "type": "string"
    },
    "alternatives_rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "choice": {
            "type": "string"
          },
          "why_not": {
            "type": "string"
          }
        },
        "required": [
          "choice",
          "why_not"
        ]
      }
    },
    "cost_delta_credits": {
      "type": "number"
    },
    "precedent_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DEC-\\d{4}$"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reversible": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scoring": {
      "type": "object",
      "description": "Optional multi-axis rubric backing 'choice' when it was picked among genuine implementation alternatives (e.g. which provider/approach to use) rather than a pure creative call. Every axis is 0-1 where 1.0 is always the MORE FAVORABLE end (M17 §3b) - 'cost' scores cost-efficiency (1.0 = cheapest), not raw spend. Most decisions never set this field.",
      "properties": {
        "axes": {
          "type": "object",
          "properties": {
            "cost": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "quota_risk": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "quality_for_style_profile": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rights_basis_strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "determinism_replay_cost": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "latency": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": true
        },
        "axes_source": {
          "type": "string",
          "description": "How the scores were derived, e.g. 'measured' (real metered data), 'estimated' (planning guess - must say so, law #4), or a decisions/*.md note id this scoring elaborates on."
        }
      },
      "required": [
        "axes"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "decision_id",
    "scope",
    "question",
    "choice",
    "reason",
    "alternatives_rejected"
  ],
  "additionalProperties": true
}
