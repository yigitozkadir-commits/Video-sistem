{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-os/schemas/flow_shot_result.schema.json",
  "title": "Flow Shot Result",
  "description": "Flow result envelope with cost and provenance.",
  "type": "object",
  "properties": {
    "task_ref": {
      "type": "string",
      "pattern": "^TSK-\\d{6}$"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^SH-\\d{3}-\\d{2}$"
    },
    "model_version": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^AST-[A-Z]{3}-\\d{6}$"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "seed": {
            "type": "integer"
          },
          "duration_s": {
            "type": "number"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          }
        },
        "required": [
          "asset_id",
          "path",
          "sha256",
          "seed"
        ]
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "units": {
          "type": "number"
        },
        "credits": {
          "type": "number"
        }
      }
    },
    "accepted_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^AST-[A-Z]{3}-\\d{6}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "type": "integer"
    },
    "retry_strategy": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "seed_variation",
            "prompt_refine",
            "reference_reinforce",
            "motion_reduce",
            "shot_simplify",
            "fallback_still"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "task_ref",
    "shot_id",
    "model_version",
    "candidates",
    "cost"
  ],
  "additionalProperties": true
}
