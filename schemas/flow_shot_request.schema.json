{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-os/schemas/flow_shot_request.schema.json",
  "title": "Flow Shot Request",
  "description": "Assembled Flow call. Max 4 references (M15 §9.2).",
  "type": "object",
  "properties": {
    "task_ref": {
      "type": "string",
      "pattern": "^TSK-\\d{6}$"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^SH-\\d{3}-\\d{2}$"
    },
    "prompt_version": {
      "type": "string",
      "pattern": "^PV-\\d{4}$"
    },
    "slots": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "lighting": {
          "type": "string"
        },
        "camera": {
          "type": "string"
        },
        "lens": {
          "type": "string"
        },
        "motion": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "technical": {
          "type": "string"
        }
      },
      "required": [
        "subject",
        "environment",
        "lighting",
        "camera",
        "lens",
        "motion",
        "style",
        "technical"
      ]
    },
    "negative": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REF-(CHR|ENV|OBJ|PAL)-\\d{3}$"
      },
      "maxItems": 4
    },
    "seed": {
      "type": "integer"
    },
    "candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "aspect_ratio": {
      "type": "string"
    },
    "duration_s": {
      "type": "number"
    },
    "model": {
      "type": "string"
    }
  },
  "required": [
    "task_ref",
    "shot_id",
    "prompt_version",
    "slots",
    "seed",
    "candidates",
    "aspect_ratio",
    "duration_s"
  ],
  "additionalProperties": true
}
