{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-os/schemas/task.schema.json",
  "title": "Task",
  "description": "The atom of the system. M13 §3.",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TSK-\\d{6}$"
    },
    "type": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[a-z0-9\\-]+$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^SC-\\d{3}$"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^SH-\\d{3}-\\d{2}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "ASSIGNED",
        "RUNNING",
        "REVIEW",
        "COMPLETED",
        "RETRY_WAIT",
        "FAILED",
        "BLOCKED",
        "CANCELLED",
        "SKIPPED"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "owner_agent": {
      "type": "string",
      "enum": [
        "technical",
        "visual",
        "audio",
        "orchestrator",
        "director",
        "review",
        "kernel"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TSK-\\d{6}$"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TSK-\\d{6}$"
      }
    },
    "input": {
      "type": "object"
    },
    "output": {
      "type": "object",
      "properties": {
        "expected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actual": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "determinism": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "prompt_version": {
          "type": "string",
          "pattern": "^PV-\\d{4}$"
        }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "estimated_credits": {
          "type": "number"
        },
        "spent_credits": {
          "type": "number"
        },
        "hard_cap": {
          "type": "number"
        }
      },
      "required": [
        "estimated_credits"
      ]
    },
    "attempts": {
      "type": "integer"
    },
    "max_attempts": {
      "type": "integer"
    },
    "retry_strategy_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attempt": {
            "type": "integer"
          },
          "strategy": {
            "type": "string"
          },
          "score_before": {
            "type": "integer"
          },
          "score_after": {
            "type": "integer"
          }
        }
      }
    },
    "checkpoint_ref": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "qa_report_ref": {
      "type": "string",
      "pattern": "^QAR-\\d{4}$"
    },
    "lease": {
      "type": "object",
      "properties": {
        "worker_id": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "task_id",
    "type",
    "state",
    "priority",
    "owner_agent",
    "budget",
    "attempts",
    "max_attempts"
  ],
  "additionalProperties": true
}
