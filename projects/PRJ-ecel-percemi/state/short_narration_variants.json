        },
        {
          "shot_range": [
            "SH-R21",
            "SH-R24"
          ],
          "window": "1:07-1:20",
          "window_s": 13,
          "text": "Halk arasında inanılırdı ki melekler şehitleri o tutamdan tutup göğe kaldırırdı. Belki de bu yüzden hiçbiri ölümden korkmadı.",
          "characters": 125,
          "words": 18,
          "draft_audio": {
            "path": "projects/PRJ-ecel-percemi/assets/audio/short_draft_variants/v1_soru_merak/seg-07.wav",
            "actual_duration_s": 7.88
