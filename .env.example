# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real keys. If you need more than one ElevenLabs key (free
# tier is 10,000 chars/month per key), add extras as
# ELEVENLABS_API_KEY_<LABEL> and swap ELEVENLABS_API_KEY manually, or edit
# .env directly - scripts load with load_dotenv(override=True) so a stale
# shell-exported var doesn't silently shadow .env (a real bug hit once,
# see scripts/generate_ryskulov_narration.py's docstring). Record every key
# you use (label, last4, quota) in a project's
# state/elevenlabs_key_ledger.jsonl - never the raw secret.

# ElevenLabs Configuration
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxx
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=default_voice_id
ELEVENLABS_STABILITY=0.80
ELEVENLABS_SIMILARITY=0.90

# ElevenLabs Music (scripts/elevenlabs_client.py's generate_music() - Music
# API, billed separately from the TTS character quota above; needs a paid
# plan, see https://elevenlabs.io/music-api)
ELEVENLABS_MUSIC_MODEL_ID=music_v2

# Google Flow Configuration (only if you automate Flow calls - most
# projects in this system generate Flow prompts as text and the human
# pastes them into the Flow web UI manually, no API credential needed)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
GOOGLE_FLOW_PROJECT_ID=your-project-id
GOOGLE_FLOW_MODEL=imagen-3-video-001
GOOGLE_FLOW_REGION=us-central1

# Optional: only needed if you wire up Module 21's Gemini-assisted channel
# analysis. Most channel-format-profile work in this system has been done
# via Claude Code + WebSearch directly (see bible/Module_21), not this key.
GEMINI_API_KEY=

# Remotion Configuration
REMOTION_OUTPUT_FORMAT=mp4
REMOTION_CODEC=h264

# Project Configuration - set per project, not globally meaningful
PROJECT_ID=PRJ-myproject
TARGET_DURATION_MINUTES=8
TARGET_FPS=30

# Production Settings
PRODUCTION_MODE=true
DETERMINISTIC_RENDERING=true
GLOBAL_SEED=20260101

# Kaggle CLI (only if you use scripts/kaggle_dataset_upload.py /
# archive_to_kaggle.py) - configured via `kaggle` CLI's own
# ~/.kaggle/kaggle.json, not env vars here. Run `kaggle --version` to
# confirm it's installed and authenticated before using those scripts.
